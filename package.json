{
  "name": "blueteam-news",
  "version": "1.4.5",
  "private": true,
  "description": "BlueTeam.News — an open-source, self-hosted threat-intelligence desk for cyber defense teams.",
  "author": "Ryan Shrier",
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanshrier/blueteam.git"
  },
  "homepage": "https://blueteam.news/",
  "bugs": {
    "url": "https://github.com/ryanshrier/blueteam/issues"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "start": "node scripts/run-node.mjs server.js",
    "dev": "node scripts/run-node.mjs server.js",
    "visual:serve": "node scripts/run-node.mjs scripts/serve-visual-fixtures.mjs",
    "test": "node scripts/run-node.mjs --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node scripts/run-node.mjs --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "check:brief-eval": "node scripts/run-node.mjs scripts/brief-eval.mjs",
    "check:brief-replay": "node scripts/run-node.mjs scripts/brief-replay.mjs",
    "check:secrets": "node scripts/run-node.mjs scripts/check-no-secrets.mjs",
    "check:history-secrets": "node scripts/run-node.mjs scripts/check-git-history-secrets.mjs",
    "check:cti-scope": "node scripts/run-node.mjs scripts/check-cti-scope.mjs",
    "check:contrast": "node scripts/run-node.mjs scripts/check-contrast.mjs",
    "check:scoring": "node scripts/run-node.mjs scripts/score-report.mjs",
    "check:release": "node scripts/run-node.mjs scripts/check-release-metadata.mjs",
    "backtest": "node scripts/run-node.mjs scripts/backtest.mjs",
    "benchmark:ranking": "node scripts/run-node.mjs scripts/ranking-benchmark.mjs",
    "check:placeholders": "node scripts/run-node.mjs scripts/check-no-placeholders.mjs",
    "check:assets": "node scripts/run-node.mjs scripts/check-assets.mjs",
    "check:landing": "node scripts/run-node.mjs scripts/check-landing-page.mjs",
    "check:landing:render": "node scripts/run-node.mjs scripts/check-landing-render.mjs",
    "check:evidence:render": "node scripts/run-node.mjs scripts/check-evidence-render.mjs",
    "check:security:render": "node scripts/run-node.mjs scripts/check-security-render.mjs",
    "check:draft:render": "node scripts/run-node.mjs scripts/check-draft-render.mjs",
    "check:reader:render": "node scripts/run-node.mjs scripts/check-reader-state-render.mjs",
    "check:production:render": "node scripts/run-node.mjs scripts/check-production-render.mjs",
    "check:design:render": "node scripts/run-node.mjs scripts/check-design-render.mjs",
    "check:theme:render": "node scripts/run-node.mjs scripts/check-theme-render.mjs",
    "check:handoff:render": "node scripts/run-node.mjs scripts/check-handoff-render.mjs",
    "check:safari:render": "node scripts/run-node.mjs scripts/check-safari-render.mjs",
    "runtime:check": "node scripts/run-node.mjs scripts/check-runtime.mjs"
  },
  "keywords": [
    "security-operations",
    "threat-intelligence",
    "soc",
    "dashboard",
    "cyber-threat-landscape",
    "briefing",
    "kiosk"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.2",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "fast-xml-parser": "^5.5.10",
    "helmet": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "marked": "^15.0.7",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0"
  },
  "overrides": {
    "body-parser@>=1.0.0 <2.0.0": "1.20.9",
    "babel-plugin-istanbul": "8.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "test-exclude": "8.0.0",
    "glob": "13.0.6",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.4",
    "qs": "6.16.0"
  }
}

# ── AI-generated Briefing ──
# Wall and Wire need no key. Choose anthropic or openai for billable Briefing
# generation. Settings can save both keys, a provider, and an OpenAI model.
# Saved provider/model choices override these defaults; environment keys override
# saved keys. Automatic generation is a separate Settings opt-in, off by default.
# If AI_PROVIDER is blank, OpenAI is selected when it is the only configured key.
AI_PROVIDER=

# Anthropic. ANTHROPIC_API_KEY_PRIMARY is also accepted as an alias.
ANTHROPIC_API_KEY=

# Optional Anthropic fallback key, used on authentication failure.
ANTHROPIC_API_KEY_SECONDARY=

# OpenAI Responses API, including Codex models. Requires an API key, not a
# Codex CLI or ChatGPT subscription login. Verification checks model access.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex

# ── Enrichment (optional) ──
# NVD API key raises the CVE-lookup rate limit (5 -> 50 requests / 30s).
# Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional identity sent to feed, article, and enrichment hosts. The default
# includes the BlueTeam.News name and version plus a blueteam.news link; set this
# to add an operator contact URL if your organization or a source requires one.
BLUETEAM_USER_AGENT=

# ── Server ──
# Port to listen on.
PORT=3000

# Bind address. Default 127.0.0.1 (localhost only) — the intended deployment.
# Run BlueTeam.News on the machine that drives the display, then open /wall on
# 127.0.0.1 from that host.
HOST=127.0.0.1

# Canonical origin used in RSS/JSON feed metadata and links sent with completed
# Briefing webhooks. Must be an absolute http(s) origin with no path, query,
# fragment, or credentials. Leave blank for request-derived local feed URLs and
# a safe http://localhost:PORT fallback in webhook links.
PUBLIC_BASE_URL=

# Bearer-token auth for /api/* except the public liveness/readiness probes. If
# set, use at least 32 random characters; the server rejects weak values and
# refuses a non-loopback HOST without a valid secret. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_SECRET=

# Allowed CORS origin (defaults to same-origin).
CORS_ORIGIN=

# Behind a reverse proxy (nginx, Caddy, Cloudflare)? Set a hop count (e.g. "1")
# or a subnet/"loopback" so Express trusts its X-Forwarded-* headers for
# rate-limiting, client IP, and emitted feed URLs. Leave unset otherwise —
# without it those headers are ignored, so a direct client can't spoof them.
# PUBLIC_BASE_URL takes precedence over forwarded headers in emitted feed URLs.
TRUST_PROXY=

# Allow the keyless /embed iframe route even when API_SECRET is enabled.
# Leave disabled unless the embedding origin and reverse proxy are locked down.
ENABLE_EMBED=

# Set to "production" for JSON logs + HSTS.
NODE_ENV=
